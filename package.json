{
  "name": "cooked-llm",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node dev/setup.js",
    "sprites": "node dev/generate-cook-sprites.js && node dev/generate-world-sprites.js",
    "dev": "vite",
    "dev:cf": "npm run build && wrangler pages dev dist --port 8789 --kv=MAPS_KV",
