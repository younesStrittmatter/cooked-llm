    "build": "vite build",
    "preview": "vite preview",
    "deploy": "node dev/deploy.js"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "vite": "^6.3.5",
    "wrangler": "^4.25.0"
  }
}
